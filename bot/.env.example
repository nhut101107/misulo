# === CONFIG BOT BAN KEY PLAY TOGETHER (MNHUT BOT) ===

# 1. Token bot Telegram tu @BotFather
BOT_TOKEN=paste-token-vao-day

# 2. Che do chay: polling (test may) | webhook (khi deploy Render/VPS)
MODE=polling
PORT=3000
WEBHOOK_URL=https://mnhut-keybot.onrender.com
WEBHOOK_SECRET=doi-secret-nay-di

# 3. SALT phai KHOP 100% voi SALT trong KeyOffline.java (APK mnhutv3.6.apk)
SALT=S6JKQT3UTCYtHNSvKgHXwRXHaNc248HR

# 4. Ngan hang nhan tien VietQR (dung khi chua cau hinh payOS hoac chuyen thu cong)
BANK_CODE=MB
BANK_ACCOUNT=0123456789
ACCOUNT_NAME=NGUYEN VAN A

# 5. Cong thanh toan tu dong payOS (payos.vn)
# Dang ky tren https://payos.vn -> Tao kenh thanh toan -> Copy 3 thong so:
PAYOS_CLIENT_ID=paste-payos-client-id-vao-day
PAYOS_API_KEY=paste-payos-api-key-vao-day
PAYOS_CHECKSUM_KEY=paste-payos-checksum-key-vao-day

# Hoac SePay (sepay.vn):
SEPAY_API_KEY=paste-sepay-api-key-vao-day

# 6. Admin Telegram (ID nhan vien / chu bot)
ADMIN_IDS=123456789

# 7. Cac goi ban key (days: so ngay, price: VND)
PACKS=[{"id":"7d","label":"7 ngay","days":7,"price":20000},{"id":"30d","label":"30 ngay","days":30,"price":50000},{"id":"vv","label":"Vinh vien","days":30000,"price":199000}]
