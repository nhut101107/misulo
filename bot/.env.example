# === COPY THANH FILE .env ROI DIEN THONG TIN THAT (khong commit .env) ===

# 1. Token bot lay tu @BotFather (m bao co roi thi dan vao day)
BOT_TOKEN=paste-token-vao-day

# 2. Che do chay: polling (test o may) | webhook (chay tren Render)
MODE=polling
PORT=3000
# Khi MODE=webhook: URL public cua Render + secret tu dat
WEBHOOK_URL=https://micu-keybot.onrender.com
WEBHOOK_SECRET=doi-secret-nay-di

# 3. SALT phai KHOP 100% voi SALT trong KeyOffline.java (APK). Bot dung no de de key.
SALT=S6JKQT3UTCYtHNSvKgHXwRXHaNc248HR

# 4. Ngan hang nhan tien (VietQR)
BANK_CODE=MB
BANK_ACCOUNT=0123456789
ACCOUNT_NAME=NGUYEN VAN A

# 5. SePay: tao tai khoan sepay.vn -> lay API key. Dang ky webhook tro toi /sepay-webhook
SEPAY_API_KEY=paste-sepay-api-key-vao-day

# 6. Admin Telegram (xem ID bang @userinfobot, nhieu ID cach nhau dau phay)
ADMIN_IDS=123456789

# 7. Goi ban (m chon "tu custom" nen sua truc tiep o day - JSON 1 dong):
#    days: so ngay (vinh vien de 30000). price: VND.
PACKS=[{"id":"7d","label":"7 ngay","days":7,"price":20000},{"id":"30d","label":"30 ngay","days":30,"price":50000},{"id":"vv","label":"Vinh vien","days":30000,"price":199000}]
